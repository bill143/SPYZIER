# =============================================================================
# SPYZIER - Transportation Fleet Monitoring System
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before running docker-compose:
#   cp .env.example .env
#
# The .env file is gitignored - never commit real secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=spyzier
POSTGRES_USER=spyzier
# REQUIRED: Change this to a strong password before deploying
POSTGRES_PASSWORD=change-me-strong-db-password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REQUIRED: Change this to a strong password before deploying
REDIS_PASSWORD=change-me-strong-redis-password

# -----------------------------------------------------------------------------
# Backend / JWT
# -----------------------------------------------------------------------------
# REQUIRED: Replace with a random 256-bit (32+ character) secret.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-256-bits-long-random-string

# Active Spring profile (docker | dev | production)
SPRING_PROFILES_ACTIVE=docker

# -----------------------------------------------------------------------------
# Frontend (Vite build-time variables)
# -----------------------------------------------------------------------------
# URL that the browser uses to reach the backend REST API
VITE_API_BASE_URL=http://localhost:8080
# URL that the browser uses for WebSocket connections
VITE_WS_URL=ws://localhost:8080/ws

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# Grafana admin password (defaults to 'admin' if not set — change for production)
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password
